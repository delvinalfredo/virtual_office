.claude/logs/

# docs/PROJECT.md and docs/plans/ are project state: commit them in a target
# project.

# Python bytecode (skill scripts are stdlib-only; never ship caches)
__pycache__/
*.pyc
*.pyo

# Secrets and local environment
.env
.env.*
!.env.example
*.key
secrets.*

# Generated skill output
.claude/skills/**/.env
